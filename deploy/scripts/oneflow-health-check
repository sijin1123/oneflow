#!/usr/bin/env bash
set -euo pipefail

target=${1:-}
mode=${2:-local}

case "$target" in
  prod)
    api_port=8000
    web_port=5173
    domain=oneflow.nexvione.net
    ;;
  dev)
    api_port=8001
    web_port=5174
    domain=dev-oneflow.nexvione.net
    ;;
  *)
    printf 'usage: %s {prod|dev} [local|external]\n' "$0" >&2
    exit 64
    ;;
esac

retry_curl() {
  local url=$1
  local attempt
  for attempt in $(seq 1 30); do
    if curl --fail --silent --show-error --max-time 5 "$url" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

retry_curl "http://127.0.0.1:${api_port}/api/v1/healthz"
retry_curl "http://127.0.0.1:${api_port}/api/v1/health"
curl --fail --silent --show-error --max-time 5 \
  "http://127.0.0.1:${api_port}/api/v1/auth/config" \
  | jq -e '.auth_mode == "oidc" and .oidc_login_enabled == true' >/dev/null
curl --fail --silent --show-error --max-time 5 \
  -H "Host: ${domain}" "http://127.0.0.1:${web_port}/" >/dev/null

if [[ "$mode" == external ]]; then
  retry_curl "https://${domain}/api/v1/healthz"
  retry_curl "https://${domain}/api/v1/health"
  retry_curl "https://${domain}/"
elif [[ "$mode" != local ]]; then
  printf 'unknown health-check mode: %s\n' "$mode" >&2
  exit 64
fi

printf '%s health check passed (%s)\n' "$target" "$mode"
