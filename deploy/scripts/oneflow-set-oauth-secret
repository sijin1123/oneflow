#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  printf 'run as root\n' >&2
  exit 77
fi
if [[ ! -t 0 ]]; then
  printf 'run from an interactive TTY; never pipe a secret into this command\n' >&2
  exit 77
fi

read -r -s -p 'Rotated Google OAuth client secret: ' secret
printf '\n'
read -r -s -p 'Confirm rotated secret: ' confirmation
printf '\n'
if [[ "$secret" != "$confirmation" ]]; then
  printf 'secret confirmation does not match\n' >&2
  exit 65
fi
if (( ${#secret} < 16 )); then
  printf 'secret is unexpectedly short\n' >&2
  exit 65
fi

for target in dev prod; do
  env_file="/etc/oneflow/${target}.env"
  temporary=$(mktemp "/etc/oneflow/.${target}.env.XXXXXX")
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ONEFLOW_OIDC_GOOGLE_CLIENT_SECRET=*)
        printf 'ONEFLOW_OIDC_GOOGLE_CLIENT_SECRET=%s\n' "$secret"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done < "$env_file" > "$temporary"
  chown root:oneflow "$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$env_file"
done

unset secret confirmation
printf 'rotated Google OAuth secret installed in dev and prod environment files\n'
for target in dev prod; do
  if systemctl is-active --quiet "oneflow-api@${target}.service"; then
    systemctl restart "oneflow-api@${target}.service"
  fi
done
