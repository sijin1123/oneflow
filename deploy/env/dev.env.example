# OneFlow development-server runtime environment.
# This is a remote staging environment, not the local developer configuration.
# Install as /etc/oneflow/dev.env with mode 0640 root:oneflow.
ONEFLOW_ENV=staging
ONEFLOW_AUTH_MODE=oidc
ONEFLOW_DEV_ALLOW_NONLOCAL=false
ONEFLOW_DEV_LOGIN_REQUIRED=false
ONEFLOW_CORS_ORIGINS=https://dev-oneflow.nexvione.net
ONEFLOW_LOG_LEVEL=INFO
ONEFLOW_API_PORT=8001

ONEFLOW_AI_SUMMARY=false
ONEFLOW_COMMAND_PALETTE_ENABLED=false
ONEFLOW_DB_POOL_SIZE=5
ONEFLOW_DB_MAX_OVERFLOW=10

ONEFLOW_STORAGE_DIR=/srv/oneflow/dev/uploads
ONEFLOW_UPLOAD_MAX_BYTES=52428800
ONEFLOW_PROJECT_STORAGE_QUOTA_BYTES=21474836480

ONEFLOW_OIDC_WEB_ORIGIN=https://dev-oneflow.nexvione.net
ONEFLOW_OIDC_GOOGLE_ISSUER=https://accounts.google.com
ONEFLOW_OIDC_GOOGLE_CLIENT_ID=152277505702-b9iqsn5pkr0satajotioseurotuiiksk.apps.googleusercontent.com
ONEFLOW_OIDC_GOOGLE_CLIENT_SECRET=REPLACE_ON_SERVER_WITH_ROTATED_SECRET
ONEFLOW_OIDC_GOOGLE_REDIRECT_URI=https://dev-oneflow.nexvione.net/api/v1/auth/oidc/callback
ONEFLOW_OIDC_GOOGLE_ALLOWED_HOSTS=oauth2.googleapis.com,www.googleapis.com
ONEFLOW_OIDC_GOOGLE_ALLOWED_EMAIL_DOMAINS=bsgone.com

ONEFLOW_WEBHOOK_ALLOWED_HOSTS=
